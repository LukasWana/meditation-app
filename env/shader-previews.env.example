# Cesta k service account JSON (absolutní nebo relativní k pracovnímu adresáři)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccounts/shader-previews-admin.json

# Firebase Storage bucket pro ukládání náhledů
FIREBASE_STORAGE_BUCKET=meditations-audio.appspot.com

# Realtime Database URL (region podle projektu)
FIREBASE_DATABASE_URL=https://meditations-audio-default-rtdb.europe-west1.firebasedatabase.app

# Interval pro watcher (volitelné, v milisekundách)
# SHADER_PREVIEW_POLL_INTERVAL=60000

