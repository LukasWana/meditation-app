rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pravidla pro audio soubory (hudba a slova složky)
    match /hudba/{allPaths=**} {
      // Veřejné čtení pro všechny (meditační audio je veřejné)
      allow read: if true;

      // Zápis POUZE pro autentifikované admin uživatele
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;

      // Dodatečné kontroly pro upload
      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       // Omezení velikosti souboru (max 50MB)
                       request.resource.size < 50 * 1024 * 1024 &&
                       // Povolené typy souborů
                       request.resource.contentType.matches('audio/.*');
    }

    // Pravidla pro slova složku
    match /slova/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       request.resource.size < 50 * 1024 * 1024 &&
                       request.resource.contentType.matches('audio/.*');
    }

    // Pravidla pro dychanie složku (OGG soubory pro dýchací cvičení)
    match /dychanie/{allPaths=**} {
      // Veřejné čtení pro všechny (dýchací audio je veřejné)
      allow read: if true;

      // Zápis POUZE pro autentifikované admin uživatele
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;

      // Dodatečné kontroly pro upload
      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       // Omezení velikosti souboru (max 50MB)
                       request.resource.size < 50 * 1024 * 1024 &&
                       // Povolené typy souborů (OGG, OGA, MP3)
                       (request.resource.contentType.matches('audio/ogg') ||
                        request.resource.contentType.matches('audio/oga') ||
                        request.resource.contentType.matches('audio/mpeg'));
    }

    // Pravidla pro meditacie složku (včetně jazykových podsložek)
    match /meditacie/{allPaths=**} {
      // Veřejné čtení včetně anonymních uživatelů (potřebujeme list/read pro admin nástroje)
      allow read: if true;

      // Zápis pouze pro autentifikované admin uživatele
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;

      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       request.resource.size < 50 * 1024 * 1024 &&
                       request.resource.contentType.matches('audio/.*');
    }

    // Pravidla pro metadata soubory
    match /metadata/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       request.resource.size < 5 * 1024 * 1024 &&
                       (request.resource.contentType.matches('application/json') ||
                        request.resource.contentType.matches('text/plain'));
    }

    // Pravidla pro shader náhledy (obrázky generované offline skriptem)
    match /shader-previews/{shaderId}/{fileName} {
      allow read: if true;

      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       request.resource.size < 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');

      allow update, delete: if request.auth != null &&
                               request.auth.token.admin == true;
    }

    // Výchozí pravidlo - zamítnout vše ostatní
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

