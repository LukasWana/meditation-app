{
  "name": "meditation-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "lint": "npm run lint:app",
    "lint:app": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0 --ignore-pattern dist --ignore-pattern coverage",
    "lint:all": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0 --ignore-pattern dist --ignore-pattern coverage",
    "preview": "npx vite preview",
    "test": "cross-env NODE_ENV=test vitest",
    "test:ui": "cross-env NODE_ENV=test vitest --ui",
    "test:coverage": "cross-env NODE_ENV=test vitest --coverage",
    "test:run": "cross-env NODE_ENV=test vitest run",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/petrona": "^5.2.8",
    "@fontsource/quicksand": "^5.2.10",
    "firebase": "^12.4.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-audio-visualize": "^1.2.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.3.0",
    "wavesurfer.js": "^7.11.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.14",
    "baseline-browser-mapping": "^2.9.6",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.11",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.15"
