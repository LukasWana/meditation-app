rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pravidla pro metadata kolekci
    match /metadata/{docId} {
      // Veřejné čtení pro všechny
      allow read: if true;

      // Zápis POUZE pro autentifikované admin uživatele
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;

      // Dodatečná validace při vytváření/update
      allow create, update: if request.auth != null &&
                               request.auth.token.admin == true &&
                               // Validace struktury dat
                               request.resource.data.keys().hasAll(['title', 'duration', 'url']) &&
                               // Validace typů
                               request.resource.data.title is string &&
                               request.resource.data.duration is number &&
                               request.resource.data.url is string;
    }

    // Pravidla pro cache kolekci
    match /cache/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
    }

    // Pravidla pro uživatelské preference (pokud existují)
    match /users/{userId} {
      // Uživatel může číst a upravovat pouze svá vlastní data
      allow read, write: if request.auth != null &&
                            request.auth.uid == userId;
    }

    // Výchozí pravidlo - zamítnout vše ostatní
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

