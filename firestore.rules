rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pravidla pro audio-metadata kolekci
    match /audio-metadata/{docId} {
      // Veřejné čtení pro všechny (meditační data jsou veřejná)
      allow read: if true;

      // Zápis POUZE pro autentifikované admin uživatele s validací dat
      allow write: if request.auth != null &&
                      request.auth.token.admin == true &&
                      // Validace struktury dat
                      request.resource.data.keys().hasAll(['fileName', 'duration', 'size']) &&
                      // Validace typů
                      request.resource.data.fileName is string &&
                      request.resource.data.duration is number &&
                      request.resource.data.size is number &&
                      // Validace rozsahů
                      request.resource.data.duration > 0 &&
                      request.resource.data.size > 0 &&
                      request.resource.data.size < 52428800; // Max 50MB
    }

    // Pravidla pro cache kolekci
    match /cache/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
    }

    // Pravidla pro uživatelské preference (pokud existují)
    match /users/{userId} {
      // Uživatel může číst a upravovat pouze svá vlastní data
      allow read, write: if request.auth != null &&
                            request.auth.uid == userId;
    }

    // Výchozí pravidlo - zamítnout vše ostatní
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

