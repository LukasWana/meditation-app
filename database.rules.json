{
  "rules": {
    // Výchozí pravidla - zamítnout vše
    ".read": false,
    ".write": false,

    // Audio metadata - veřejné čtení, zápis pouze pro autentifikované
    "audio-metadata": {
      ".read": true,
      ".write": "auth != null"
    },

    // Audio statistiky - veřejné čtení, zápis pouze pro autentifikované
    "audio_stats": {
      ".read": true,
      ".write": "auth != null"
    },

    // Test data - pouze pro autentifikované
    "test": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // Metadata - veřejné čtení, zápis pro autentifikované
    "metadata": {
      ".read": true,
      ".write": "auth != null"
    },

    // Shader previews - veřejné čtení, zápis pouze pro admin uživatele
    "shader-previews": {
      ".read": true,
      "$shaderId": {
        ".write": "auth != null"
      }
    },

    // Logy generování shader náhledů - pouze admini
    "shader-previews-logs": {
      ".read": "auth != null && auth.token != null && auth.token.admin == true",
      ".write": "auth != null && auth.token != null && auth.token.admin == true"
    },

    // System data - pouze pro autentifikované
    "system": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // User data - každý uživatel může číst/zapisovat pouze své vlastní data
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // UI data - veřejné čtení (texty, překlady, konfigurace), zápis pro autentifikované
    "ui-data": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}