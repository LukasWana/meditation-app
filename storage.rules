rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pravidla pro audio soubory
    match /media/{allPaths=**} {
      // Veřejné čtení pro všechny (meditační audio je veřejné)
      allow read: if true;

      // Zápis POUZE pro autentifikované admin uživatele
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;

      // Dodatečné kontroly pro upload
      allow create: if request.auth != null &&
                       request.auth.token.admin == true &&
                       // Omezení velikosti souboru (max 100MB)
                       request.resource.size < 100 * 1024 * 1024 &&
                       // Povolené typy souborů
                       request.resource.contentType.matches('audio/.*');
    }

    // Pravidla pro metadata soubory
    match /metadata/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
    }

    // Výchozí pravidlo - zamítnout vše ostatní
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

