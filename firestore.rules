rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pravidla pro audio-metadata kolekci
    match /audio-metadata/{docId} {
      // Veřejné čtení pro všechny (meditační data jsou veřejná)
      allow read: if true;

      // Zápis pouze pro admin uživatele
      allow write: if request.auth != null &&
                     request.auth.token.admin == true;

      // Alternativně: Zápis POUZE pro autentifikované admin uživatele
      // allow write: if request.auth != null &&
      //                 request.auth.token.admin == true;
    }

    // Pravidla pro cache kolekci
    match /cache/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
    }

    // Pravidla pro uživatelské preference (pokud existují)
    match /users/{userId} {
      // Uživatel může číst a upravovat pouze svá vlastní data
      allow read, write: if request.auth != null &&
                            request.auth.uid == userId;
    }

    // Výchozí pravidlo - zamítnout vše ostatní
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

